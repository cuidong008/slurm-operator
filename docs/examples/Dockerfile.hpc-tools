# syntax=docker/dockerfile:1

#
# Build two hardened variants for Slurm images:
# - target: login-hpc  (base: login image)
# - target: worker-hpc (base: slurmd image)
#
# Usage is documented in docs/installation-harbor.md.
#

ARG BASE_LOGIN_IMAGE=harbor.aix.com:8443/slinkyproject/login:25.11-ubuntu24.04
ARG BASE_WORKER_IMAGE=harbor.aix.com:8443/slinkyproject/slurmd:25.11-ubuntu24.04
# Optional: set to e.g. mirrors.aliyun.com when proxy → archive.ubuntu.com returns 502.
ARG APT_MIRROR_HOST=

FROM ${BASE_LOGIN_IMAGE} AS login-hpc

USER root

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG APT_MIRROR_HOST
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY}
ENV http_proxy=${http_proxy} https_proxy=${https_proxy} no_proxy=${no_proxy}

RUN set -eux; \
    retry() { \
      n=0; \
      until [ "$n" -ge 5 ]; do \
        "$@" && break; \
        n=$((n+1)); \
        echo "retry $n/5: $*"; \
        sleep $((n*3)); \
      done; \
      [ "$n" -lt 5 ]; \
    }; \
    export DEBIAN_FRONTEND=noninteractive; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
      for f in /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list; do \
        [ -f "$f" ] || continue; \
        sed -i \
          -e "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          -e "s|https://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          -e "s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          -e "s|https://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          "$f" || true; \
      done; \
    fi; \
    retry apt-get -o Acquire::Retries=5 update; \
    retry apt-get install -y --no-install-recommends --fix-missing \
      lmod \
      build-essential \
      gfortran \
      cmake \
      python3-pip \
      jq \
      rsync \
      libpam-modules; \
    if apt-cache show apptainer >/dev/null 2>&1; then \
      retry apt-get install -y --no-install-recommends --fix-missing apptainer; \
      command -v singularity >/dev/null 2>&1 || ln -sf "$(command -v apptainer)" /usr/local/bin/singularity; \
    elif apt-cache show singularity-container >/dev/null 2>&1; then \
      retry apt-get install -y --no-install-recommends --fix-missing singularity-container; \
      command -v apptainer >/dev/null 2>&1 || ln -sf "$(command -v singularity)" /usr/local/bin/apptainer; \
    else \
      echo "ERROR: neither apptainer nor singularity-container package found in apt repositories"; \
      exit 1; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    grep -q "pam_mkhomedir.so" /etc/pam.d/common-session || \
      echo "session required pam_mkhomedir.so skel=/etc/skel umask=0022" >> /etc/pam.d/common-session

FROM ${BASE_WORKER_IMAGE} AS worker-hpc

USER root

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG APT_MIRROR_HOST
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY}
ENV http_proxy=${http_proxy} https_proxy=${https_proxy} no_proxy=${no_proxy}

RUN set -eux; \
    retry() { \
      n=0; \
      until [ "$n" -ge 5 ]; do \
        "$@" && break; \
        n=$((n+1)); \
        echo "retry $n/5: $*"; \
        sleep $((n*3)); \
      done; \
      [ "$n" -lt 5 ]; \
    }; \
    export DEBIAN_FRONTEND=noninteractive; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
      for f in /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list; do \
        [ -f "$f" ] || continue; \
        sed -i \
          -e "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          -e "s|https://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          -e "s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          -e "s|https://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
          "$f" || true; \
      done; \
    fi; \
    retry apt-get -o Acquire::Retries=5 update; \
    retry apt-get install -y --no-install-recommends --fix-missing \
      lmod \
      build-essential \
      gfortran \
      cmake \
      python3-pip \
      jq \
      rsync \
      libpam-modules; \
    if apt-cache show apptainer >/dev/null 2>&1; then \
      retry apt-get install -y --no-install-recommends --fix-missing apptainer; \
      command -v singularity >/dev/null 2>&1 || ln -sf "$(command -v apptainer)" /usr/local/bin/singularity; \
    elif apt-cache show singularity-container >/dev/null 2>&1; then \
      retry apt-get install -y --no-install-recommends --fix-missing singularity-container; \
      command -v apptainer >/dev/null 2>&1 || ln -sf "$(command -v singularity)" /usr/local/bin/apptainer; \
    else \
      echo "ERROR: neither apptainer nor singularity-container package found in apt repositories"; \
      exit 1; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    grep -q "pam_mkhomedir.so" /etc/pam.d/common-session || \
      echo "session required pam_mkhomedir.so skel=/etc/skel umask=0022" >> /etc/pam.d/common-session
