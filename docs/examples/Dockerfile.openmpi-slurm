#
# Build two variants with OpenMPI rebuilt to support Slurm direct launch (PMI/PMIx).
# - target: login-openmpi-slurm  (base: login image)
# - target: worker-openmpi-slurm (base: slurmd image)
#
# Notes:
# - Intentionally does NOT install MPICH.
# - Open MPI **5.x** (not 4.1): v4 often still hits internal pmix3x_client.c under srun even with
#   --with-pmix=external (see open-mpi/ompi#10307). v5 drops --with-pmi and uses external libpmix for Slurm.
#   External PMIx requires external hwloc + libevent (not internal copies); use Ubuntu libhwloc-dev / libevent-dev.
# - Installs under /opt/openmpi; symlinks in /usr/local/bin (not update-alternatives).
# - apt uses Acquire::http::Proxy::… DIRECT for Ubuntu mirrors so build-time HTTP_PROXY (e.g. localhost
#   Clash) does not break large apt downloads with 502.
#
ARG BASE_LOGIN_IMAGE=harbor.aix.com:8443/slinkyproject/login:25.11-ubuntu24.04
ARG BASE_WORKER_IMAGE=harbor.aix.com:8443/slinkyproject/slurmd:25.11-ubuntu24.04
ARG APT_MIRROR_HOST=
ARG OPENMPI_VERSION=5.0.6
# release path segment, e.g. v5.0 for 5.0.x
ARG OPENMPI_SERIES=v5.0
ARG OPENMPI_TARBALL_SHA256=

FROM ${BASE_LOGIN_IMAGE} AS openmpi-builder

USER root

ARG APT_MIRROR_HOST
ARG OPENMPI_VERSION
ARG OPENMPI_SERIES=v5.0
ARG OPENMPI_TARBALL_SHA256

RUN set -eux; \
  retry() { \
    n=0; \
    until [ "$n" -ge 5 ]; do \
      "$@" && break; \
      n=$((n+1)); \
      echo "retry $n/5: $*"; \
      sleep $((n*3)); \
    done; \
    [ "$n" -lt 5 ]; \
  }; \
  export DEBIAN_FRONTEND=noninteractive; \
  install -d /etc/apt/apt.conf.d; \
  { \
    printf '%s\n' \
      'Acquire::http::Proxy::archive.ubuntu.com "DIRECT";' \
      'Acquire::https::Proxy::archive.ubuntu.com "DIRECT";' \
      'Acquire::http::Proxy::security.ubuntu.com "DIRECT";' \
      'Acquire::https::Proxy::security.ubuntu.com "DIRECT";'; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
      printf 'Acquire::http::Proxy::%s "DIRECT";\n' "${APT_MIRROR_HOST}"; \
    fi; \
  } > /etc/apt/apt.conf.d/99direct-ubuntu.conf; \
  if [ -n "${APT_MIRROR_HOST}" ]; then \
    for f in /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list; do \
      [ -f "$f" ] || continue; \
      sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        -e "s|https://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        -e "s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        -e "s|https://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        "$f" || true; \
    done; \
  fi; \
  retry apt-get -o Acquire::Retries=5 update; \
  retry apt-get -y -f install; \
  retry apt-get install -y --no-install-recommends --fix-missing --fix-broken \
    --allow-change-held-packages --allow-downgrades \
    autoconf \
    automake \
    build-essential \
    ca-certificates \
    curl \
    file \
    gfortran \
    libevent-dev \
    libhwloc-dev \
    libnuma-dev \
    libtool \
    pkg-config \
    # External PMIx (OMPI 5 has no --with-pmi; Slurm/srun uses PMIx)
    libpmix-dev \
    # Optional but commonly useful
    zlib1g-dev; \
  rm -rf /var/lib/apt/lists/*; \
  mkdir -p /tmp/openmpi-src; \
  cd /tmp/openmpi-src; \
  retry curl -fsSLo openmpi.tar.gz "https://download.open-mpi.org/release/open-mpi/${OPENMPI_SERIES}/openmpi-${OPENMPI_VERSION}.tar.gz"; \
  if [ -n "${OPENMPI_TARBALL_SHA256}" ]; then \
    echo "${OPENMPI_TARBALL_SHA256}  openmpi.tar.gz" | sha256sum -c -; \
  fi; \
  tar -xzf openmpi.tar.gz; \
  cd "openmpi-${OPENMPI_VERSION}"; \
  export PKG_CONFIG_PATH="/usr/lib/x86_64-linux-gnu/pkgconfig:${PKG_CONFIG_PATH:-}"; \
  CPPFLAGS="-I/usr/include" LDFLAGS="-L/usr/lib/x86_64-linux-gnu" ./configure \
    --prefix=/opt/openmpi \
    --disable-static \
    --enable-shared \
    --with-pmix=external \
    --with-pmix-libdir=/usr/lib/x86_64-linux-gnu \
    --with-hwloc=external \
    --with-hwloc-libdir=/usr/lib/x86_64-linux-gnu \
    --with-libevent=external \
    --with-libevent-libdir=/usr/lib/x86_64-linux-gnu; \
  make -j"$(nproc)"; \
  make install; \
  pal="$(ls /opt/openmpi/lib/libopen-pal.so.* 2>/dev/null | head -1)"; \
  test -n "${pal}"; \
  ldd "${pal}" | grep -E 'libpmix\.|not found'; \
  ldd "${pal}" | grep -q libpmix || { echo "Open MPI libopen-pal not linked to libpmix (external PMIx required for Slurm srun)." >&2; exit 1; }; \
  # Ensure runtime loader finds libmpi without extra env vars
  echo "/opt/openmpi/lib" > /etc/ld.so.conf.d/openmpi.conf; \
  ldconfig; \
  /opt/openmpi/bin/ompi_info --version

FROM ${BASE_LOGIN_IMAGE} AS login-openmpi-slurm

USER root

ARG APT_MIRROR_HOST

RUN set -eux; \
  retry() { \
    n=0; \
    until [ "$n" -ge 5 ]; do \
      "$@" && break; \
      n=$((n+1)); \
      echo "retry $n/5: $*"; \
      sleep $((n*3)); \
    done; \
    [ "$n" -lt 5 ]; \
  }; \
  export DEBIAN_FRONTEND=noninteractive; \
  install -d /etc/apt/apt.conf.d; \
  { \
    printf '%s\n' \
      'Acquire::http::Proxy::archive.ubuntu.com "DIRECT";' \
      'Acquire::https::Proxy::archive.ubuntu.com "DIRECT";' \
      'Acquire::http::Proxy::security.ubuntu.com "DIRECT";' \
      'Acquire::https::Proxy::security.ubuntu.com "DIRECT";'; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
      printf 'Acquire::http::Proxy::%s "DIRECT";\n' "${APT_MIRROR_HOST}"; \
    fi; \
  } > /etc/apt/apt.conf.d/99direct-ubuntu.conf; \
  if [ -n "${APT_MIRROR_HOST}" ]; then \
    for f in /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list; do \
      [ -f "$f" ] || continue; \
      sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        -e "s|https://archive.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        -e "s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        -e "s|https://security.ubuntu.com/ubuntu|http://${APT_MIRROR_HOST}/ubuntu|g" \
        "$f" || true; \
    done; \
  fi; \
  retry apt-get -o Acquire::Retries=5 update; \
  retry apt-get -y -f install; \
  retry apt-get install -y --no-install-recommends --fix-missing --fix-broken \
    --allow-change-held-packages --allow-downgrades \
    build-essential \
    ca-certificates \
    gfortran \
    libevent-core-2.1-7t64 \
    libhwloc15 \
    libnuma1 \
    libpmix2 \
    libslurm40t64; \
  rm -rf /var/lib/apt/lists/*

COPY --from=openmpi-builder /opt/openmpi /opt/openmpi
COPY --from=openmpi-builder /etc/ld.so.conf.d/openmpi.conf /etc/ld.so.conf.d/openmpi.conf

RUN set -eux; \
  ldconfig; \
  # Avoid update-alternatives: Ubuntu `mpi` group ties mpicc/mpicxx as master/slave, and
  # `mpirun`/`mpiexec` use other groups — easy to conflict. Prefer /usr/local/bin (earlier in PATH).
  for b in mpicc mpicxx mpif77 mpif90 mpirun mpiexec; do \
    ln -sf "/opt/openmpi/bin/$b" "/usr/local/bin/$b"; \
  done; \
  ln -sf /opt/openmpi/bin/ompi_info /usr/local/bin/ompi_info; \
  /opt/openmpi/bin/ompi_info --version; \
  mpicc -show

