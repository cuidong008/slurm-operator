mysql:
  host: __MYSQL_HOST__
  port: __MYSQL_PORT__
  user: __MYSQL_USER__
  dbname: __MYSQL_DBNAME__
  password: "__DB_PASSWORD__"
  clustername: __MYSQL_CLUSTERNAME__
  databaseencode: __MYSQL_DATABASE_ENCODE__
# v1.6.0 使用 service.port（监听 :port 即全网卡）；勿用 addr（旧版字段，会导致 port=0 随机端口）
service:
  port: 8972
slurm:
  defaultqos: normal
modulepath:
  path: /etc/profile
