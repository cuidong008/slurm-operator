# Slurm Accounting 数据库密码（与 K8s Secret slurm-accounting-db / key password 一致）
# 若密码含 $，在 Docker Compose 的 .env 里须写成 $$（例如 AbCd$$1234），否则 Compose 会当作变量展开。
DB_PASSWORD=your-mysql-password-here

# MySQL 地址（写入 config 的 mysql.host）。默认 172.16.84.71。
# 若报 Access denied for user 'slurm'@'172.17.0.1'：见 README「MySQL 1045」— 可在库上 GRANT 172.17.% ，或
# 使用 docker-compose.hostnet.yml 并在下面改为 127.0.0.1（DB 在本机时）。
MYSQL_HOST=172.16.84.71

# MySQL 用户名（写入 config 的 mysql.user）。可与 MYSQL_USER 或 DB_USER 二选一；默认 slurm。
# DB_USER=slurm
# MYSQL_USER=slurm

# 以下为可选；不设则与 Slurm Accounting 常见默认一致（见 entrypoint.sh）
# MYSQL_PORT=3306
# MYSQL_DBNAME=slurm_acct_db
# 或与部分客户端习惯一致也可用 MYSQL_DATABASE（与 MYSQL_DBNAME 二选一）
# MYSQL_DATABASE=slurm_acct_db
# sacctmgr 中的集群名，须与账务库一致；默认 slurm
# MYSQL_CLUSTERNAME=slurm
# 连接字符集；默认 latin1
# MYSQL_DATABASE_ENCODE=latin1
